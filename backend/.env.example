# Copy to .env for local development. Never commit real credentials.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
IRSA_OBSCORE_TABLE=ivoa.obscore
IRSA_QUERY_TIMEOUT_SECONDS=45
IRSA_MAX_ROWS=100
# Comma-separated collections; update only after checking official IRSA release docs.
SPHEREX_COLLECTIONS=spherex_dr1,spherex_qr2,spherex_qr3
